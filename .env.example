# Copy this file to .env and fill in as needed. No secrets are hardcoded anywhere in app/.

# Storage
CHROMA_DIR=./storage/chroma
COLLECTION_NAME=rag_corpus
DATA_DIR=./data/corpus

# Chunking defaults
CHUNK_SIZE=200
CHUNK_OVERLAP=40

# Retrieval
DEFAULT_TOP_K=4
MIN_SIMILARITY=0.15

# LLM (optional). Leave blank to run in extractive-fallback mode (no external calls).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=auto
LLM_MODEL=claude-sonnet-4-6
